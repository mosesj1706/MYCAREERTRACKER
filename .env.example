# Copy this file to .env and paste your key from console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Optional. GitHub sync works without it for public repos (60 API calls/hour).
# A token (github.com/settings/tokens, "public_repo" or "repo" scope) raises the limit and includes private repos.
# GITHUB_TOKEN=ghp_...

# --- Cost controls (all optional) ---
# Claude model for judgment calls (profile, GitHub merge, match, tailor, interview). Default: claude-sonnet-5.
# claude-opus-5 is the strongest and 2.5x the price; claude-haiku-4-5 is cheaper still.
# MCT_MODEL=claude-sonnet-5

# Free provider for the 'basic' tier (JD extraction, MCQs, LinkedIn text, resource ranking).
# Any failure falls back to Claude. Options: gemini | ollama | claude (default = Claude for everything).
# MCT_BASIC_PROVIDER=gemini
# GEMINI_API_KEY=...            # free key from aistudio.google.com (free tier: Google may train on prompts)
# GEMINI_MODEL=gemini-2.5-flash
# OLLAMA_MODEL=llama3.1:8b      # for MCT_BASIC_PROVIDER=ollama; run `ollama pull llama3.1:8b` first
